SPRING_PROFILES_ACTIVE=production
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<database>
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>

APP_SCHEDULER_ENABLED=false
APP_SCHEDULER_PREGAME_ENABLED=true
APP_SCHEDULER_LIVE_ENABLED=false
APP_SCHEDULER_POST_FINAL_ENABLED=true
KBO_LIVE_SYNC_ENABLED=false

APNS_ENV=production
APNS_TEAM_ID=<apple-team-id>
APNS_KEY_ID=<apns-key-id>
APNS_BUNDLE_ID=com.chogm.kboScore
APNS_PRIVATE_KEY_PATH=/path/to/AuthKey_<key-id>.p8
KBO_PUSH_ENABLED=true
KBO_APNS_TEST_ENABLED=false
