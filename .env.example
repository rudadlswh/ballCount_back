# Docker runtime (docker-compose.yml enforces production and port 8088)
SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8088
APP_DB_SCHEMA=kbo_crawler_api
APP_RUNTIME_ROLE=writer
# Keep both writers disabled for the first Docker boot. Enable them only after
# REST/SSE/DB verification and immediately after suspending the Render writer.
APP_SYNC_ENABLED=false

# Supabase PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:<port>/<database>?sslmode=require&currentSchema=kbo_crawler_api
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>

# HikariCP / PostgreSQL connection health
DB_POOL_MAX_LIFETIME=600000
DB_POOL_KEEPALIVE_TIME=120000
DB_TCP_KEEP_ALIVE=true

# Admin APIs and operations console
# KBO_ADMIN_API_KEY takes precedence; ADMIN_API_KEY remains as a compatibility fallback.
KBO_ADMIN_API_KEY=<strong-random-api-key>
ADMIN_API_KEY=<strong-random-api-key>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong-admin-password>
ADMIN_SESSION_TIMEOUT=30m
ADMIN_SESSION_COOKIE_SECURE=true
ADMIN_STALE_GAME_THRESHOLD=2m
ADMIN_LOG_CAPACITY=2000

# Public registration protection
REGISTRATION_REQUEST_MAX_BYTES=32768
REGISTRATION_RATE_LIMIT_ENABLED=true
REGISTRATION_RATE_LIMIT_MAX_REQUESTS=12
REGISTRATION_RATE_LIMIT_WINDOW=1m

# Real-time game synchronization
KBO_LIVE_SYNC_LOCK_MODE=memory
KBO_LIVE_SYNC_SCHEDULER_INTERVAL=PT1S
KBO_LIVE_SYNC_RETRY_INTERVAL=PT10S
KBO_LIVE_SYNC_IDLE_INTERVAL=PT30M
KBO_LIVE_SYNC_PREGAME_CHECK_INTERVAL=PT5M
KBO_LIVE_SYNC_PREGAME_FAST_POLLING_WINDOW=PT30M
KBO_LIVE_SYNC_PREGAME_FAST_POLLING_INTERVAL=PT1M
KBO_LIVE_SYNC_LIVE_POLLING_INTERVAL=PT1S
KBO_LIVE_SYNC_FINAL_CONFIRMATION_POLLING_INTERVAL=PT30S
KBO_LIVE_SYNC_LIVE_TTL=PT3S
KBO_LIVE_SYNC_FINAL_CONFIRMATION_TTL=PT30S

# APNs. Put the key in ./secrets; this path is inside the container.
APNS_ENV=production
APNS_TEAM_ID=<apple-team-id>
APNS_KEY_ID=<apns-key-id>
APNS_BUNDLE_ID=com.chogm.kboScore
APNS_PRIVATE_KEY_PATH=/run/secrets/AuthKey_<key-id>.p8
KBO_PUSH_ENABLED=false
KBO_APNS_TEST_ENABLED=false

# FCM (optional; leave disabled when Android push is not configured)
KBO_FCM_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FCM_ENV=production
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
FCM_ENDPOINT=https://fcm.googleapis.com

# Reconciliation and upstream HTTP limits
KBO_RECONCILE_PUBLIC_MAX_DATES=3
KBO_RECONCILE_PUBLIC_ALLOWED_PAST_DAYS=7
KBO_RECONCILE_PUBLIC_COOLDOWN=3m
KBO_RECONCILE_ADMIN_MAX_DATES=31
KBO_HTTP_CONNECT_TIMEOUT=3s
KBO_HTTP_READ_TIMEOUT=8s
KBO_HTTP_REQUEST_TIMEOUT=10s
